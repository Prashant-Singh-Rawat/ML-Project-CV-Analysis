# ── Authentication ─────────────────────────────────────────────────────────────
# REQUIRED. Minimum 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# NEVER use "secret", "changeme", or any short/guessable value.
JWT_SECRET_KEY=your_super_secret_jwt_key_here

# ── Database ───────────────────────────────────────────────────────────────────
# Optional. Defaults to backend/auth/users.db (relative to source file).
# Set an absolute path in production to avoid accidental exposure.
DB_PATH=your_db_path

# Rate limiting (requests per minute per IP). Tune these for your traffic.
RATE_ANALYZE=5/minute
RATE_FEATURES_HVY=10/minute
RATE_FEATURES_LGT=20/minute
RATE_AUTH=10/minute

